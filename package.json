{
  "name": "zendo",
  "private": true,
  "version": "0.1.0",
  "description": "Zendo \u2013 a calm, GTD-inspired todo and planning app that runs on localhost",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.ts",
    "web": "vite",
    "server": "node server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "calendar:check": "node scripts/check-m365.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@azure/msal-node": "^7.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "i18next": "^26.5.2",
    "lucide-react": "^1.59.0",
    "openai": "^7.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
