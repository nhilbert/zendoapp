# Copy to .env (gitignored) and fill in. These two IDs are not secrets, but keep them out of the repo anyway.
# Never create or paste a client secret: Zendo is a public client (loopback + PKCE).
MS_CLIENT_ID=
MS_TENANT_ID=

# Optional AI help ("Auto" in Clarify). One key is enough; Claude is used if both are set,
# unless ZENDO_AI_PROVIDER says otherwise. Keys stay on this machine and never reach the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ZENDO_AI_PROVIDER=anthropic   # or openai
# ZENDO_AI_MODEL=claude-opus-5-5

# Hosting behind a reverse proxy with a login in front (docs/architecture.md, section 11). Leave unset locally.
# The Dockerfile already sets ZENDO_HOST=0.0.0.0, ZENDO_DATA_DIR=/data and ZENDO_CALENDAR_LOGIN=device.
# ZENDO_PUBLIC_URL=https://zendo.example.com   # its host and origin pass the API guard
# ZENDO_CALENDAR_LOGIN=device                  # Microsoft sign-in with a code at microsoft.com/devicelogin

# AI agents via MCP (docs/mcp.md). `npm run mcp` (stdio) needs none of this; /mcp over HTTP needs OAuth or a token.
# ZENDO_MCP_OAUTH=1                       # OAuth for Claude connectors (claude.ai, Desktop, Claude Code)
# ZENDO_OAUTH_USERS=you@example.com       # hosted: who may approve, as signed in at the login proxy
# ZENDO_OAUTH_USER_HEADER=x-auth-request-email
# ZENDO_MCP_TOKEN=                        # optional static bearer token for scripts
# ZENDO_MCP_HIDE_PRIVATE=1   # keep private projects, tasks and appointments away from the agent
# TZ=Europe/Berlin           # "today" for the plan tools; containers default to UTC
