# Copy to .env (gitignored) and fill in. These two IDs are not secrets, but keep them out of the repo anyway.
# Never create or paste a client secret: Zendo is a public client (loopback + PKCE).
MS_CLIENT_ID=
MS_TENANT_ID=

# Optional AI help ("Auto" in Clarify). One key is enough; Claude is used if both are set,
# unless ZENDO_AI_PROVIDER says otherwise. Keys stay on this machine and never reach the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ZENDO_AI_PROVIDER=anthropic   # or openai
# ZENDO_AI_MODEL=claude-opus-5-5
